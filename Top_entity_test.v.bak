
module mandelbrot_top #(
    parameter W = 27,
    parameter W_CONT = 8
)(
    input wire clk,
    input wire reset,
    input wire start,

    input wire [W_CONT-1:0] n_max,

    input wire [13*W-1:0] c_re_bus,
    input wire [13*W-1:0] c_im_bus,

    output wire [13-1:0] stop_bus,
    output wire [13*W_CONT-1:0] n_bus
);

    genvar i;

    generate
        for (i = 0; i < 13; i = i + 1) begin : GEN_MANDELBROT

            mandelbrot_n_finder #(
                .W(W),
                .W_CONT(W_CONT)
            ) finder_inst (
                .c_re(c_re_bus[i*W +: W]),
                .c_im(c_im_bus[i*W +: W]),
                .n_max(n_max),
                .clk(clk),
                .reset(reset),
                .start(start),
                .stop(stop_bus[i]),
                .n(n_bus[i*W_CONT +: W_CONT])
            );

        end
    endgenerate

endmodule
